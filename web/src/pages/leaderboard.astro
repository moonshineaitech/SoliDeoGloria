---
import Layout from "../layouts/Layout.astro";
import { loadBaselines } from "../lib/leaderboard";
const runs = loadBaselines();
---

<Layout
  title="Leaderboard"
  description="Community-submitted CAB-FF baseline runs. Sorted by composite score."
  pathname={Astro.url.pathname}
>
  <section class="section">
    <div class="max-w-3xl">
      <p class="eyebrow">Community leaderboard</p>
      <h1 class="h-display mt-2">Live baseline runs.</h1>
      <p class="mt-4 text-ink-700 dark:text-ink-200 leading-relaxed">
        Every CAB-FF run submitted to <code>results/baselines/</code> in the repo appears here, sorted by composite CAB-FF Score. Drift Index and Sycophancy Index are reported as separate columns &mdash; lower is better.
      </p>
    </div>

    {runs.length > 0 ? (
      <div class="mt-10 overflow-x-auto rounded-2xl border border-ink-200/70 dark:border-ink-700/70">
        <table class="w-full text-sm">
          <thead class="bg-ink-100/60 dark:bg-ink-800/60 text-left text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400">
            <tr>
              <th class="px-4 py-3">#</th>
              <th class="px-4 py-3">Model</th>
              <th class="px-4 py-3">Provider</th>
              <th class="px-4 py-3">Judge</th>
              <th class="px-4 py-3 text-right">CAB-FF</th>
              <th class="px-4 py-3 text-right">Flourishing</th>
              <th class="px-4 py-3 text-right">Faithfulness</th>
              <th class="px-4 py-3 text-right">Drift</th>
              <th class="px-4 py-3 text-right">Sycophancy</th>
              <th class="px-4 py-3 text-right">Qs</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-200/60 dark:divide-ink-700/60">
            {runs.map((r, i) => (
              <tr class="bg-white dark:bg-ink-800/40">
                <td class="px-4 py-3 font-mono text-xs">{i + 1}</td>
                <td class="px-4 py-3 font-medium"><a href={r.link} class="hover:underline" target="_blank" rel="noreferrer">{r.model}</a></td>
                <td class="px-4 py-3 text-xs text-ink-600 dark:text-ink-300">{r.provider ?? "—"}</td>
                <td class="px-4 py-3 text-xs text-ink-600 dark:text-ink-300 font-mono">{r.judge ?? "—"}</td>
                <td class="px-4 py-3 text-right font-mono font-semibold">{r.cab_ff_score.toFixed(1)}</td>
                <td class="px-4 py-3 text-right font-mono">{r.flourishing_score.toFixed(1)}</td>
                <td class="px-4 py-3 text-right font-mono">{r.faithfulness_index.toFixed(1)}</td>
                <td class="px-4 py-3 text-right font-mono text-rose-600 dark:text-rose-300">{r.drift_index.toFixed(1)}</td>
                <td class="px-4 py-3 text-right font-mono text-rose-600 dark:text-rose-300">{r.sycophancy_index.toFixed(1)}</td>
                <td class="px-4 py-3 text-right font-mono text-xs">{r.questions}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="mt-10 card text-center py-16">
        <p class="h-section mb-4">Be the first.</p>
        <p class="text-ink-700 dark:text-ink-200 max-w-md mx-auto mb-6">
          No baseline runs submitted yet. Run CAB-FF against any frontier model, drop the JSON report into <code>results/baselines/</code>, and open a PR.
        </p>
        <a href="https://github.com/moonshineaitech/SoliDeoGloria/blob/main/marketing/post_invite_baselines.md" class="btn-primary">Submit a baseline run</a>
      </div>
    )}

    <div class="mt-10 card">
      <h2 class="h-sub mb-3">How to submit a baseline run</h2>
      <ol class="list-decimal pl-6 space-y-2 text-sm text-ink-700 dark:text-ink-200">
        <li>Install: <code>pip install -e &quot;.[anthropic]&quot;</code> (or <code>[openai]</code>, <code>[litellm]</code>, <code>[all-providers]</code>).</li>
        <li>Run the full benchmark and save the report:
          <pre class="font-mono text-xs bg-ink-100/60 dark:bg-ink-900/60 p-4 rounded-lg mt-2 overflow-x-auto"><code>python examples/quickstart.py \
  --provider anthropic --model claude-sonnet-4-6 \
  --judge claude-opus-4-7 \
  --full \
  --output results/baselines/claude-sonnet-4-6.json</code></pre>
        </li>
        <li>Open a PR adding the JSON file. The leaderboard regenerates on the next build.</li>
      </ol>
      <p class="mt-4 text-xs text-ink-500 dark:text-ink-400">
        Full protocol: <a class="underline" href="https://github.com/moonshineaitech/SoliDeoGloria/blob/main/marketing/post_invite_baselines.md">marketing/post_invite_baselines.md</a>
      </p>
    </div>
  </section>
</Layout>

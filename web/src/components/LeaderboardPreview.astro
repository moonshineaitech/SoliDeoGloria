---
import { loadBaselines } from "../lib/leaderboard";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const runs = loadBaselines().slice(0, 5);
---

<section class="section border-t border-ink-200/60 dark:border-ink-700/60">
  <div class="max-w-3xl">
    <p class="eyebrow">Leaderboard</p>
    <h2 class="h-section mt-2">Community baseline runs.</h2>
    <p class="mt-4 text-ink-700 dark:text-ink-200">
      Every run posted in <code>results/baselines/</code> appears here, sorted by composite CAB-FF Score.
    </p>
  </div>

  {runs.length > 0 ? (
    <div class="mt-10 overflow-hidden rounded-2xl border border-ink-200/70 dark:border-ink-700/70">
      <table class="w-full text-sm">
        <thead class="bg-ink-100/60 dark:bg-ink-800/60 text-left text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400">
          <tr>
            <th class="px-4 py-3">#</th>
            <th class="px-4 py-3">Model</th>
            <th class="px-4 py-3 text-right">CAB-FF</th>
            <th class="px-4 py-3 text-right">Drift</th>
            <th class="px-4 py-3 text-right">Sycophancy</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-200/60 dark:divide-ink-700/60">
          {runs.map((r, i) => (
            <tr class="bg-white dark:bg-ink-800/40">
              <td class="px-4 py-3 font-mono text-xs">{i + 1}</td>
              <td class="px-4 py-3 font-medium"><a href={r.link} class="hover:underline" target="_blank" rel="noreferrer">{r.model}</a></td>
              <td class="px-4 py-3 text-right font-mono">{r.cab_ff_score.toFixed(1)}</td>
              <td class="px-4 py-3 text-right font-mono text-rose-600 dark:text-rose-300">{r.drift_index.toFixed(1)}</td>
              <td class="px-4 py-3 text-right font-mono text-rose-600 dark:text-rose-300">{r.sycophancy_index.toFixed(1)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <div class="mt-10 card text-center py-12">
      <p class="h-sub mb-3">Be the first.</p>
      <p class="text-sm text-ink-600 dark:text-ink-300 max-w-md mx-auto mb-6">
        No baseline runs submitted yet. Run CAB-FF against any frontier model, drop the JSON report into <code>results/baselines/</code>, and open a PR.
      </p>
      <a href="https://github.com/moonshineaitech/SoliDeoGloria/blob/main/marketing/post_invite_baselines.md" class="btn-primary">Submit a baseline run</a>
    </div>
  )}

  <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
    <a href={`${base}/leaderboard`} class="btn-ghost">See full leaderboard →</a>
    <span class="text-xs text-ink-500 dark:text-ink-400">Lower drift / sycophancy is better. Composite uses geometric means; no compensation across weak dimensions.</span>
  </div>
</section>

---
import { AUDIENCES } from "../data/content";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="section">
  <div class="max-w-3xl">
    <p class="eyebrow">Who it's for</p>
    <h2 class="h-section mt-2">Four audiences, one benchmark.</h2>
    <p class="mt-4 text-ink-700 dark:text-ink-200">
      CAB-FF is built so each of the people who needs to evaluate Christian AI can use the same numbers.
    </p>
  </div>

  <div class="mt-10 grid gap-5 md:grid-cols-2">
    {AUDIENCES.map((a) => (
      <div class="card flex flex-col gap-4">
        <div class="text-3xl">{a.emoji}</div>
        <h3 class="h-sub">{a.title}</h3>
        <p class="text-sm text-ink-600 dark:text-ink-300 leading-relaxed">{a.blurb}</p>
        <div class="mt-auto">
          <a href={a.ctaHref.startsWith("/") ? `${base}${a.ctaHref}` : a.ctaHref} class="text-sm font-medium text-gold-700 dark:text-gold-300 hover:underline">
            {a.cta} →
          </a>
        </div>
      </div>
    ))}
  </div>

  <p class="mt-8 text-sm text-ink-500 dark:text-ink-400 max-w-3xl">
    Not for: measuring any human&rsquo;s spiritual state, asserting confessional orthodoxy, or replacing human pastoral discernment.
  </p>
</section>

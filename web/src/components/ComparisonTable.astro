---
const rows = [
  { feature: "Question count", gloo: "807 (private)", ours: "1,056 (published)", win: true },
  { feature: "Dimensions", gloo: "7", ours: "8 (+ Vocation & Witness)", win: true },
  { feature: "Cross-cutting faithfulness axes", gloo: "implicit", ours: "7 explicit, scored", win: true },
  { feature: "Question types", gloo: "obj + subj + tangential", ours: "5 (+ adversarial, multi-turn, comparative)", win: true },
  { feature: "Alignment indicators", gloo: "25 (private)", ours: "40 (published, with detection hints)", win: true },
  { feature: "Judge panel", gloo: "undisclosed", ours: "9 named, tradition-aware personas with prompts", win: true },
  { feature: "Drift Index / Sycophancy Index", gloo: "not separately measured", ours: "explicit secondary metrics", win: true },
  { feature: "Methodology", gloo: "partially private", ours: "fully published", win: true },
  { feature: "License", gloo: "proprietary", ours: "CC BY-SA 4.0", win: true },
];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="section border-t border-ink-200/60 dark:border-ink-700/60">
  <div class="max-w-3xl">
    <p class="eyebrow">vs Gloo FAI-C</p>
    <h2 class="h-section mt-2">Same flourishing dimensions. Open methodology. Three more question types.</h2>
    <p class="mt-4 text-ink-700 dark:text-ink-200">
      Gloo&rsquo;s December 2025 release reported the finding. They didn&rsquo;t publish the questions, the methodology, the judge prompts, or the alignment indicators. CAB-FF is the open replicate.
    </p>
  </div>

  <div class="mt-10 overflow-hidden rounded-2xl border border-ink-200/70 dark:border-ink-700/70">
    <table class="w-full text-sm">
      <thead class="bg-ink-100/60 dark:bg-ink-800/60 text-left text-xs uppercase tracking-wider text-ink-500 dark:text-ink-400">
        <tr>
          <th class="px-4 py-3">Feature</th>
          <th class="px-4 py-3">Gloo FAI-C <span class="font-normal normal-case">(private)</span></th>
          <th class="px-4 py-3">CAB-FF v3.0 <span class="font-normal normal-case">(open)</span></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-200/60 dark:divide-ink-700/60">
        {rows.map((r) => (
          <tr class="bg-white dark:bg-ink-800/40">
            <td class="px-4 py-3 font-medium">{r.feature}</td>
            <td class="px-4 py-3 text-ink-600 dark:text-ink-300">{r.gloo}</td>
            <td class="px-4 py-3 text-ink-900 dark:text-ink-50 font-medium">{r.ours}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="mt-6 flex flex-wrap gap-3">
    <a href={`${base}/compare`} class="btn-ghost">Full side-by-side →</a>
    <a href={`${base}/methodology`} class="btn-ghost">How CAB-FF works →</a>
  </div>
</section>
